# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ─── Cases App URL (used in admin lead notification emails) ──────────────────
CASES_APP_URL=https://app.zenowethu.co.za

# ─── Notifications ────────────────────────────────────────────────────────────
# GHL (GoHighLevel) — primary notification channel
GHL_API_KEY=REPLACE_ME
GHL_LOCATION_ID=REPLACE_ME

# SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@zenowethu.co.za
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=notifications@zenowethu.co.za

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
