# Local development environment
# Copy this file to .env.local and fill in real values
# NEVER commit real credentials to this file
# ??  ROTATE ALL SECRETS BEFORE PRODUCTION DEPLOYMENT

DATABASE_URL="postgresql://postgres:REPLACE_ME_PASSWORD@REPLACE_ME_HOST:5432/postgres"
# ??  NEXTAUTH_SECRET must be identical across all 5 apps for SSO to work
# ??  Generate a new shared secret for production: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_ME_SECRET
AUTH_SECRET=REPLACE_ME_SECRET
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
OPENAI_API_KEY=sk-proj-REPLACE_ME_API_KEY

# Notifications
SMS_ENABLED=true
EMAIL_ENABLED=true
WHATSAPP_ENABLED=true

# GoHighLevel
GHL_SMS_WEBHOOK_URL=YOUR_GHL_SMS_WEBHOOK_URL
GHL_EMAIL_WEBHOOK_URL=YOUR_GHL_EMAIL_WEBHOOK_URL
GHL_WEBHOOK_URL=
