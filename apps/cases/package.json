{
  "name": "cases",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema=../../packages/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema=../../packages/database/prisma/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@types/busboy": "^1.5.4",
    "@zenowethu/config": "workspace:*",
    "@zenowethu/database": "workspace:*",
    "@zenowethu/shared-lib": "workspace:*",
    "@zenowethu/ui": "workspace:*",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "date-fns": "^4.1.0",
    "next": "16.0.6",
    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^7.0.11",
    "openai": "^6.9.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "puppeteer": "^24.32.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-simple-wysiwyg": "^3.4.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "@sentry/nextjs": "^9.1.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.25",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@playwright/test": "^1.50.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.0.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "prisma": {
    "schema": "../../packages/database/prisma/schema.prisma",
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  }
}
