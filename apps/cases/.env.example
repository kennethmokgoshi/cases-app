# Local development environment
# Copy this file to .env.local and fill in real values
# NEVER commit real credentials to this file
# ⚠️  ROTATE ALL SECRETS BEFORE PRODUCTION DEPLOYMENT

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:REPLACE_ME_PASSWORD@REPLACE_ME_HOST:5432/postgres"

# ─── NextAuth / SSO ───────────────────────────────────────────────────────────
# ⚠️  NEXTAUTH_SECRET must be identical across all 5 apps for SSO to work
# ⚠️  Generate a new shared secret for production: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_ME_SECRET
AUTH_SECRET=REPLACE_ME_SECRET
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Primary fallback (used if no provider configured in Admin → AI Providers)
OPENAI_API_KEY=sk-proj-REPLACE_ME_API_KEY

# Anthropic Claude — used by plan-engine for AI plan generation and evaluation
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional: additional direct provider keys (used as ENV fallback by provider-client.ts)
# OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME     # Access Claude, GPT-4o, Gemini via 1 key
# GOOGLE_AI_API_KEY=REPLACE_ME               # Direct Google Gemini access

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.REPLACE_ME_PROVIDER.com
SMTP_PORT=587
SMTP_USER=noreply@zenowethu.co.za
SMTP_PASSWORD=REPLACE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@zenowethu.co.za

# ─── NCR Debt Help System (DHS) ───────────────────────────────────────────────
DHS_USERNAME=REPLACE_ME_DHS_USERNAME
DHS_PASSWORD=REPLACE_ME_DHS_PASSWORD

# ─── GoHighLevel CRM ──────────────────────────────────────────────────────────
GHL_API_KEY=REPLACE_ME_GHL_API_KEY
GHL_CLIENT_ID=REPLACE_ME_GHL_CLIENT_ID
GHL_CLIENT_SECRET=REPLACE_ME_GHL_CLIENT_SECRET
GHL_SMS_WEBHOOK_URL=REPLACE_ME_GHL_SMS_WEBHOOK_URL
GHL_EMAIL_WEBHOOK_URL=REPLACE_ME_GHL_EMAIL_WEBHOOK_URL
GHL_WEBHOOK_URL=

# ─── Notifications ────────────────────────────────────────────────────────────
SMS_ENABLED=true
EMAIL_ENABLED=true
WHATSAPP_ENABLED=true

# ─── Sentry (Error Monitoring) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=REPLACE_ME_SENTRY_DSN
SENTRY_AUTH_TOKEN=REPLACE_ME_SENTRY_AUTH_TOKEN
SENTRY_ORG=zenowethu
SENTRY_PROJECT=cases

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
