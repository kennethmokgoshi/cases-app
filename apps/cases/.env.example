# Local development environment
# Copy this file to .env.local and fill in real values
# NEVER commit real credentials to this file
# ⚠️  ROTATE ALL SECRETS BEFORE PRODUCTION DEPLOYMENT

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:REPLACE_ME_PASSWORD@REPLACE_ME_HOST:5432/postgres"

# ─── NextAuth / SSO ───────────────────────────────────────────────────────────
# ⚠️  NEXTAUTH_SECRET must be identical across all 5 apps for SSO to work
# ⚠️  Generate a new shared secret for production: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_ME_SECRET
AUTH_SECRET=REPLACE_ME_SECRET
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Primary fallback (used if no provider configured in Admin → AI Providers)
OPENAI_API_KEY=sk-proj-REPLACE_ME_API_KEY

# Anthropic Claude — used by plan-engine for AI plan generation and evaluation
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional: additional direct provider keys (used as ENV fallback by provider-client.ts)
# OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME     # Access Claude, GPT-4o, Gemini via 1 key
# GOOGLE_AI_API_KEY=REPLACE_ME               # Direct Google Gemini access

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.REPLACE_ME_PROVIDER.com
SMTP_PORT=587
SMTP_USER=notifications@zenowethu.co.za
SMTP_PASSWORD=REPLACE_ME_SMTP_PASSWORD
SMTP_FROM=notifications@zenowethu.co.za

# Optional: BCC all outbound emails to an audit mailbox (blind copy — recipient won't see)
# Useful for monitoring/compliance — emails stay in notifications@zenowethu.co.za sent items
EMAIL_BCC_ADDRESS=notifications@zenowethu.co.za

# ─── NCR Debt Help System (DHS) ───────────────────────────────────────────────
DHS_USERNAME=REPLACE_ME_DHS_USERNAME
DHS_PASSWORD=REPLACE_ME_DHS_PASSWORD

# ─── GoHighLevel CRM ──────────────────────────────────────────────────────────
GHL_API_KEY=REPLACE_ME_GHL_API_KEY
GHL_CLIENT_ID=REPLACE_ME_GHL_CLIENT_ID
GHL_CLIENT_SECRET=REPLACE_ME_GHL_CLIENT_SECRET
GHL_SMS_WEBHOOK_URL=REPLACE_ME_GHL_SMS_WEBHOOK_URL
GHL_EMAIL_WEBHOOK_URL=REPLACE_ME_GHL_EMAIL_WEBHOOK_URL
GHL_WEBHOOK_URL=

# ─── Notifications ────────────────────────────────────────────────────────────
SMS_ENABLED=true
EMAIL_ENABLED=true
WHATSAPP_ENABLED=true
# Telegram is off by default; needs TELEGRAM_BOT_TOKEN + per-client chat id (Client.telegramNumber)
TELEGRAM_ENABLED=false

# ─── Messaging provider selection (optional) ──────────────────────────────────
# Force a specific gateway; leave blank to auto-detect (GHL first, then fallbacks).
# SMS_PROVIDER:      ghl | clickatell | twilio | mock
# WHATSAPP_PROVIDER: ghl | twilio | meta | mock
# EMAIL_PROVIDER:    smtp | ghl | resend | mock
#   GHL is not yet set up — set EMAIL_PROVIDER=smtp so direct SMTP is the primary email
#   path (avoids a failing GHL API call on every send). Leave blank once GHL is live.
SMS_PROVIDER=
WHATSAPP_PROVIDER=
EMAIL_PROVIDER=smtp

# ─── Clickatell (SA SMS gateway) ──────────────────────────────────────────────
CLICKATELL_API_KEY=REPLACE_ME_CLICKATELL_API_KEY

# ─── Twilio (SMS + WhatsApp) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=REPLACE_ME_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_ME_TWILIO_AUTH_TOKEN
# SMS sender: a Twilio number (+1...) or Messaging Service SID (MG...)
TWILIO_SMS_FROM=REPLACE_ME_TWILIO_SMS_FROM
# WhatsApp sender, e.g. +14155238886 (the whatsapp: prefix is added automatically)
TWILIO_WHATSAPP_FROM=REPLACE_ME_TWILIO_WHATSAPP_FROM

# ─── Meta WhatsApp Cloud API (direct) ─────────────────────────────────────────
META_WHATSAPP_TOKEN=REPLACE_ME_META_WHATSAPP_TOKEN
META_WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME_META_PHONE_NUMBER_ID
META_WHATSAPP_API_VERSION=v21.0
# Business-initiated messages need an approved template; leave blank to send free text
# (free text only delivers inside the 24-hour customer-service window).
META_WHATSAPP_TEMPLATE=
META_WHATSAPP_TEMPLATE_LANG=en

# ─── Telegram Bot API (direct, free) ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REPLACE_ME_TELEGRAM_BOT_TOKEN
# Shared secret echoed by Telegram in the X-Telegram-Bot-Api-Secret-Token header;
# pass the same value to setWebhook's secret_token. Leave blank to skip verification.
TELEGRAM_WEBHOOK_SECRET=REPLACE_ME_TELEGRAM_WEBHOOK_SECRET

# ─── Sentry (Error Monitoring) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=REPLACE_ME_SENTRY_DSN
SENTRY_AUTH_TOKEN=REPLACE_ME_SENTRY_AUTH_TOKEN
SENTRY_ORG=zenowethu
SENTRY_PROJECT=cases

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
