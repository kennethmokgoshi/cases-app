# Local development environment — Crediva consumer portal
# Copy this file to .env.local and fill in real values
# NEVER commit real credentials to this file

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:REPLACE_ME_PASSWORD@REPLACE_ME_HOST:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# ⚠️  Generate for production: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_ME_SECRET
AUTH_SECRET=REPLACE_ME_SECRET
NEXTAUTH_URL=http://localhost:3005
AUTH_TRUST_HOST=true

# ─── Cross-app integration ────────────────────────────────────────────────────
# Base URL of the Cases app — Crediva calls it server-to-server (e.g. to trigger the
# post-consent document readiness check after a consumer approves in the portal).
# Example (prod): https://app.zenowethu.co.za
CASES_APP_URL=http://localhost:3000

# Shared secret for those server-to-server calls (sent as the x-internal-secret
# header). Must be IDENTICAL in the Cases and Crediva apps. Generate: openssl rand -hex 32
INTERNAL_API_SECRET=REPLACE_ME_INTERNAL_SECRET

# Public base URL of this Crediva app — used when building activation / reset links.
# Example (prod): https://crediva.zenowethu.co.za
CREDO_URL=http://localhost:3005

# ─── Platform & company identity ─────────────────────────────────────────────
# PLATFORM_* = the product/operator (same for every tenant). Shown in app chrome,
# system notifications and AI system prompts. Rebrand = change these values.
PLATFORM_NAME=Zenowethu
PLATFORM_URL=https://cases.zenowethu.co.za
PLATFORM_SUPPORT_EMAIL=notifications@zenowethu.co.za
NEXT_PUBLIC_PLATFORM_NAME=Zenowethu
NEXT_PUBLIC_PLATFORM_URL=https://cases.zenowethu.co.za

# COMPANY_* = optional env fallbacks for the tenant firm's profile. The saved
# profile (Admin → Settings → Company Profile, stored in SystemSettings category
# "company_profile") always wins; with nothing saved these apply, then the
# built-in Zenowethu defaults.
# COMPANY_NAME=Zenowethu Debt Management
# COMPANY_PHONE=081 747 7616
# COMPANY_VAT_NUMBER=4590307072
# COMPANY_BANK_NAME=FNB
# COMPANY_BANK_ACCOUNT=62867268635
# COMPANY_BRANCH_CODE=250655

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
