# Local development environment — Credo consumer portal
# Copy this file to .env.local and fill in real values
# NEVER commit real credentials to this file

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:REPLACE_ME_PASSWORD@REPLACE_ME_HOST:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# ⚠️  Generate for production: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_ME_SECRET
AUTH_SECRET=REPLACE_ME_SECRET
NEXTAUTH_URL=http://localhost:3005
AUTH_TRUST_HOST=true

# ─── Cross-app integration ────────────────────────────────────────────────────
# Base URL of the Cases app — Credo calls it server-to-server (e.g. to trigger the
# post-consent document readiness check after a consumer approves in the portal).
# Example (prod): https://app.zenowethu.co.za
CASES_APP_URL=http://localhost:3000

# Shared secret for those server-to-server calls (sent as the x-internal-secret
# header). Must be IDENTICAL in the Cases and Credo apps. Generate: openssl rand -hex 32
INTERNAL_API_SECRET=REPLACE_ME_INTERNAL_SECRET

# Public base URL of this Credo app — used when building activation / reset links.
# Example (prod): https://credo.zenowethu.co.za
CREDO_URL=http://localhost:3005

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
