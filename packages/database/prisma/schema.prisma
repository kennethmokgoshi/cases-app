// Email inboxes the app can search for DC fee invoices and proof-of-payment
// replies. Shared org mailboxes (ownerUserId = null) are password-managed by
// Admin only; a personal mailbox belongs to one staff user who manages their
// own password (Admin cannot set it). Passwords are AES-256-GCM encrypted via
// @zenowethu/shared-lib encryptSecret before storage.
model MailboxAccount {
  id                String    @id @default(cuid())
  label             String
  emailAddress      String    @unique
  imapHost          String
  imapPort          Int       @default(993)
  imapSecure        Boolean   @default(true)
  // Encrypted IMAP password; null until set — mailbox is not searchable without it
  password          String?
  // Marks the mailbox used to communicate with other debt counsellors
  isDcCommunication Boolean   @default(false)
  isActive          Boolean   @default(true)
  ownerUserId       String?   @unique
  owner             User?     @relation("MailboxOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  notes             String?
  lastCheckedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isActive])
}

model DCCPCredential {
  id        String   @id @default(cuid())
  username  String
  password  String
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique
  portalUrl String   @default("https://portal.colms.co.za/arsys/shared/login.jsp?/arsys/")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Staff member's own personal banking details — self-service, used only to
