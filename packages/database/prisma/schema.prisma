  responseDate     DateTime?
  responseContent  String?
  status           String      @default("DRAFT")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  legalMatter      LegalMatter @relation(fields: [legalMatterId], references: [id], onDelete: Cascade)

  @@index([legalMatterId])
  @@index([letterType])
  @@index([status])
}

model LegalPrescriptionCheck {
