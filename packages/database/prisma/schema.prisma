  legalBasis            String?
  notes                 String?
  checkedAt             DateTime    @default(now())
  checkedById           String?
  legalMatter           LegalMatter @relation(fields: [legalMatterId], references: [id], onDelete: Cascade)

  @@index([legalMatterId])
  @@index([isPrescribed])
}

model AuditEvidence {
