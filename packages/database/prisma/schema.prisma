model Lead {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  idNumber        String?
  phone           String
  email           String?
  /// One of: debt-review-removal | court-rescission | credit-repair | insurance
  service         String
  /// NEW | CONTACTED | CONVERTED | REJECTED | DUPLICATE | CLOSED
  status          String   @default("NEW")
  /// Where the lead originated — WEBSITE_ASSESSMENT | FACEBOOK_AD | INSTAGRAM_AD | TIKTOK | LINKEDIN | PINTEREST | WEBSITE_CHAT | WEBSITE_VOICE | GHL_MANUAL | REFERRAL
  source          String   @default("WEBSITE_ASSESSMENT")
  popiaConsent    Boolean  @default(false)
  notes           String?
  convertedCaseId String?
  assignedToId    String?
  /// GoHighLevel contact ID — set when lead originates from or is synced with GHL
  ghlContactId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  assignedTo      User?    @relation("LeadAssignment", fields: [assignedToId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([assignedToId])
  @@index([ghlContactId])
}

model AutomationRun {
  id             String    @id @default(cuid())
  type           String // DHS_SYNC, XDS_SYNC, GHL_WEBHOOK, AI_DOC_ANALYSIS, AI_PLAN_GEN, POPIA_CHECK
  status         String    @default("QUEUED") // QUEUED, RUNNING, SUCCESS, FAILED, RETRYING, CANCELLED, NEEDS_REVIEW
  caseId         String?
  clientId       String?
  userId         String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  durationMs     Int?
  errorMessage   String?
  retryCount     Int       @default(0)
  nextRetryAt    DateTime?
  logs           Json?
  screenshotPath String?
  triggeredById  String?
  environment    String    @default("PRODUCTION") // PRODUCTION, STAGING, DEVELOPMENT

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case        Case?   @relation(fields: [caseId], references: [id])
  client      Client? @relation(fields: [clientId], references: [id])
  user        User?   @relation(fields: [userId], references: [id])
  triggeredBy User?   @relation("AutomationTrigger", fields: [triggeredById], references: [id])

  @@index([type])
  @@index([status])
  @@index([caseId])
  @@index([clientId])
}

// ─── POA Online Signing ────────────────────────────────────────────────────────
// Tracks every POA sent via email, WhatsApp, or Credo that has an online
// signing link. Status: PENDING → SIGNED (or EXPIRED / CANCELLED).
// The `token` field is the URL-safe identifier embedded in the signing link.

model PoaSigningRequest {
  id            String    @id @default(cuid())
  token         String    @unique @default(cuid())
  status        String    @default("PENDING") // PENDING | SIGNED | EXPIRED | CANCELLED
  poaType       String // STANDARD | WESBANK
  channel       String // EMAIL | WHATSAPP | CREDO
  caseId        String?
  clientId      String?
  consumerId    String?
  expiresAt     DateTime
  signedAt      DateTime?
  signedPdfPath String? // server path of the signed PDF
  ipAddress     String? // captured at signing for ECTA audit trail
  userAgent     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  case     Case?            @relation(fields: [caseId], references: [id])
  client   Client?          @relation(fields: [clientId], references: [id])
  consumer ConsumerAccount? @relation(fields: [consumerId], references: [id])

  @@index([token])
  @@index([caseId])
  @@index([clientId])
  @@index([consumerId])
  @@index([status])
}

/// Consumer consent to proceed with debt review removal, captured via a unique
/// public link sent after a file is Accepted via DHS (status codes A/C/D3/D4).
/// Granting consent fires the onDebtReviewRemovalConsent() hook (extension point).
model DebtReviewRemovalConsent {
  id          String    @id @default(cuid())
  token       String    @unique @default(cuid())
  status      String    @default("PENDING") // PENDING | CONSENTED | EXPIRED | CANCELLED
  channel     String    @default("EMAIL") // EMAIL | WHATSAPP | CREDO
  caseId      String
  clientId    String?
  consumerId  String?
  expiresAt   DateTime
  consentedAt DateTime?
  ipAddress   String? // captured at consent for POPIA / ECTA audit trail
  userAgent   String?
  consentText String? // snapshot of the exact wording the consumer agreed to
  triggeredAt DateTime? // when the post-consent hook fired (set by the trigger)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  case     Case             @relation(fields: [caseId], references: [id])
  client   Client?          @relation(fields: [clientId], references: [id])
  consumer ConsumerAccount? @relation(fields: [consumerId], references: [id])

  @@index([token])
  @@index([caseId])
  @@index([clientId])
  @@index([consumerId])
  @@index([status])
}
