  judgmentDate       DateTime?
  judgmentAmount     Decimal?
  judgmentCourt      String?
  judgmentCaseNumber String?
  debtReviewDate     DateTime?
  debtCounsellorName String?
  courtOrderDate     DateTime?
  letterSent         Boolean                  @default(false)
  letterSentDate     DateTime?
  responseReceived   Boolean                  @default(false)
  responseDate       DateTime?
  responseNotes      String?
  outcome            String?
  outcomeDate        DateTime?
  outcomeNotes       String?
  amountSaved        Decimal?
  status             String                   @default("OPEN")
  priority           String                   @default("MEDIUM")
