  uploadedAt   DateTime  @default(now())
  status       String    @default("PROCESSING")
  totalAmount  Decimal   @default(0)
  matchCount   Int       @default(0)
  unmatchCount Int       @default(0)
  uploadedById String
  payments     Payment[]
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])

  @@index([uploadedAt])
}

model Invoice {
  id                    String        @id @default(cuid())
  invoiceNumber         String        @unique
  status                InvoiceStatus @default(DRAFT)
  clientId              String?
  caseId                String?
  projectId             String?
  lineItems             Json
  subtotal              Decimal       @default(0)
  vatRate               Decimal       @default(0.15)
  vatAmount             Decimal       @default(0)
  total                 Decimal       @default(0)
  issuedAt              DateTime      @default(now())
  dueAt                 DateTime
  pdfPath               String?
  sentAt                DateTime?
  sentTo                String?
  notes                 String?
  reference             String?
  createdById           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  bankAccountId         String?
  type                  DocumentType  @default(INVOICE)
  publicToken           String?       @unique
  // Debt-counsellor bill-to details — populated only for DC_FEE_INVOICE type.
  // The consumer the fees relate to is the linked `client`/`case` (or stored in
  // `reference` for standalone invoices with no case in the system).
  dcName                String?
  dcEmail               String?
  dcTradingName         String?
  // Quote lifecycle — set when a client accepts/rejects a quotation
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  decisionNote          String?
  decidedById           String?
  // Set when an ACCEPTED quote is converted into an invoice
  convertedToInvoiceId  String?       @unique
  // Set instead of bankAccountId when a staff member's own personal banking is
  // used (R350 admin fee invoices, or Admin choosing "use my own banking").
  personalBankingUserId String?
  bankAccount           BankAccount?  @relation(fields: [bankAccountId], references: [id])
  case                  Case?         @relation(fields: [caseId], references: [id])
  client                Client?       @relation(fields: [clientId], references: [id])
  createdBy             User?         @relation("InvoiceCreator", fields: [createdById], references: [id])
  decidedBy             User?         @relation("InvoiceDecider", fields: [decidedById], references: [id])
  project               Project?      @relation(fields: [projectId], references: [id])
  convertedToInvoice    Invoice?      @relation("QuoteConversion", fields: [convertedToInvoiceId], references: [id])
  convertedFromQuote    Invoice?      @relation("QuoteConversion")
  personalBankingUser   User?         @relation("InvoicePersonalBanking", fields: [personalBankingUserId], references: [id])
  payments              Payment[]

  @@index([status])
  @@index([type])
  @@index([clientId])
  @@index([caseId])
  @@index([issuedAt])
  @@index([dueAt])
  @@index([personalBankingUserId])
}

model DocumentSequence {
  id        String   @id @default(cuid())
  prefix    String // QUO or INV
  year      Int
  nextSeq   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([prefix, year])
  @@index([prefix, year])
}

model BankAccount {
  id            String    @id @default(cuid())
  bankName      String
  accountName   String
  accountNumber String
  branchCode    String?
  accountType   String    @default("CHEQUE")
  isDefault     Boolean   @default(false)
  isActive      Boolean   @default(true)
  reference     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoices      Invoice[]

  @@index([isActive])
}

model ServicePrice {
  id         String   @id @default(cuid())
  serviceKey String   @unique
  label      String
  price      Decimal  @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CredoTenant {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  primaryColor String            @default("#0B1D35")
  accentColor  String            @default("#C4953A")
  logoUrl      String?
  ncrdc        String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  consumers    ConsumerAccount[]
  coupons      CouponCode[]

  @@index([slug])
}

model ConsumerAccount {
  id                   String                     @id @default(cuid())
  email                String
  // Nullable: auto-provisioned profiles (created from a B2B/staff case) have no
  // password until the consumer activates via the password-reset link.
  password             String?
  // Tracks whether the consumer has ever set a password (activated their login).
  activatedAt          DateTime?
  // Forces a password change on next login (set for default/staff-issued passwords).
  mustChangePassword   Boolean                    @default(false)
  passwordChangedAt    DateTime?
  // Brute-force protection: consecutive failed logins and optional lockout window.
  failedLoginAttempts  Int                        @default(0)
  lockedUntil          DateTime?
  // How the profile was created: SELF_REGISTERED | AUTO_PROVISIONED
  source               String                     @default("SELF_REGISTERED")
  firstName            String
  lastName             String
  idNumber             String?                    @unique
  phone                String?
  province             String?
  language             String                     @default("English")
  tenantId             String?
  isVerified           Boolean                    @default(false)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  linkedClientId       String?                    @unique
  isAdmin              Boolean                    @default(false)
  projectId            String?
  role                 String                     @default("CONSUMER")
  activeSubscriptionId String?                    @unique
  linkedClient         Client?                    @relation(fields: [linkedClientId], references: [id])
  project              Project?                   @relation(fields: [projectId], references: [id])
  tenant               CredoTenant?               @relation(fields: [tenantId], references: [id])
  documents            CredoDocument[]
  serviceRequests      ServiceRequest[]
  subscriptions        CredoSubscription[]
  activeSubscription   CredoSubscription?         @relation("ActiveSubscription", fields: [activeSubscriptionId], references: [id])
  poaSigningRequests   PoaSigningRequest[]
  drrConsents          DebtReviewRemovalConsent[]
  otpSession           CredoOtpSession?
  passwordResetTokens  PasswordResetToken[]
  documentRequests     DocumentRequest[]
  passwordHistory      ConsumerPasswordHistory[]

  @@index([email])
  @@index([tenantId])
  @@index([idNumber])
}

// Retains recent bcrypt hashes so a consumer cannot reuse any of their last
// 5 passwords (POPIA-aligned credential hygiene). Rows are trimmed on write.
model ConsumerPasswordHistory {
  id           String          @id @default(cuid())
  consumerId   String
  passwordHash String
  createdAt    DateTime        @default(now())
  consumer     ConsumerAccount @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  @@index([consumerId, createdAt])
}

model PasswordResetToken {
  id         String          @id @default(cuid())
  consumerId String
  // SHA-256 hash of the token — the raw token is only ever in the emailed link.
  tokenHash  String          @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime        @default(now())
  consumer   ConsumerAccount @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  @@index([consumerId])
  @@index([expiresAt])
}

model DocumentRequest {
  id             String          @id @default(cuid())
  consumerId     String
  caseId         String?
  category       String // IDENTITY | INCOME | BUREAU | LEGAL | CORRESPONDENCE
  label          String // Human-readable ask, e.g. "Latest 3 months' payslips"
  notes          String?
  status         String          @default("REQUESTED") // REQUESTED | UPLOADED | APPROVED | REJECTED
  fulfilledDocId String?         @unique
  requestedById  String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  consumer       ConsumerAccount @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  case           Case?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  fulfilledDoc   CredoDocument?  @relation(fields: [fulfilledDocId], references: [id], onDelete: SetNull)

  @@index([consumerId])
  @@index([caseId])
  @@index([status])
}

model CredoSubscription {
  id               String           @id @default(cuid())
  consumerId       String
  planId           String // e.g., 'credo-premium', 'credo-free'
  status           String           @default("TRIALING") // TRIALING, ACTIVE, PAST_DUE, CANCELLED
  providerRef      String? // Peach Payments/PayFast reference or token
  currentPeriodEnd DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  consumer         ConsumerAccount  @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  activeFor        ConsumerAccount? @relation("ActiveSubscription")

  @@index([consumerId])
  @@index([status])
}

model CredoOtpSession {
  id          String          @id @default(cuid())
  consumerId  String          @unique // One active OTP per consumer
  phone       String // Phone number to send OTP to
  otpCode     String // 6-digit OTP code
  attempts    Int             @default(0) // Login attempts with wrong OTP
  maxAttempts Int             @default(3) // Max attempts before locking
  isVerified  Boolean         @default(false)
  expiresAt   DateTime // When OTP expires (typically 15 minutes from creation)
  createdAt   DateTime        @default(now())
  consumer    ConsumerAccount @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  @@index([consumerId])
  @@index([expiresAt])
}

/// Telegram bot conversation + identity-binding state, keyed by Telegram chat id.
/// A chat is anonymous until the consumer verifies (ID number → email OTP); once
/// VERIFIED, clientId is bound and the bot answers questions about that client's file.
model TelegramSession {
  id                String    @id @default(cuid())
  chatId            String    @unique // Telegram chat id (the bot's handle on the user)
  state             String    @default("AWAITING_ID") // AWAITING_ID | AWAITING_OTP | VERIFIED
  clientId          String? // set once verified & bound to a Client
  candidateClientId String? // Client matched by ID number, pending OTP confirmation
  otpCode           String? // active 6-digit verification code
  otpExpiresAt      DateTime? // when the active OTP expires
  attempts          Int       @default(0) // wrong-OTP / failed-lookup attempts
  lastInboundAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([clientId])
}

model CredoDocument {
