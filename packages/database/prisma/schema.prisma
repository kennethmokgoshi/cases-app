  auditId       String
  fileName      String
  fileUrl       String
  fileType      String
  category      String        @default("GENERAL")
  description   String?
  uploadedAt    DateTime      @default(now())
  uploadedBy    String
  uploadedById  String?
  ForensicAudit ForensicAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  User          User?         @relation(fields: [uploadedById], references: [id])

  @@index([auditId])
  @@index([category])
  @@index([uploadedById])
