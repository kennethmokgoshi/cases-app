generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id              String             @id @default(cuid())
  name            String
  description     String?
  type            String             @default("FOLDER")
  clientType      String?
  parentId        String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  order           Int                @default(0)
  accentColor     String?            @default("#C4953A")
  companySlogan   String?
  logoUrl         String?
  primaryColor    String?            @default("#0B1D35")
  termsUrl        String?
  billingEmail    String?
  apiKeys         ApiKey[]
  cases           CaseProject[]
  consumers       ConsumerAccount[]
  invoices        Invoice[]
  parent          Project?           @relation("ProjectHierarchy", fields: [parentId], references: [id])
  children        Project[]          @relation("ProjectHierarchy")
  members         ProjectMember[]
  referrer        Referrer?
  b2bPartnerUsers User[]             @relation("B2BPartnerUsers")
  resources       DocumentResource[] @relation("DocumentResourceToProject")
}

model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  role       String   @default("MEMBER")
  assignedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Referrer {
  id                    String               @id @default(cuid())
  firstName             String
  lastName              String
  idNumber              String?              @unique
  email                 String?
  cellNumber            String?
  employerName          String?
  employmentType        String?
  employerAddress       String?
  employerPhone         String?
  occupation            String?
  monthlyIncome         Decimal?
  bankName              String?
  accountNumber         String?
  accountType           String?
  branchCode            String?
  accountHolderName     String?
  projectId             String?              @unique
  portalUserId          String?              @unique
  isActive              Boolean              @default(true)
  notes                 String?
  createdById           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  // Referrer type — COMMISSION referrers earn a payout per referral (clients pay
  // full price); DISCOUNT referrers earn nothing but their clients get discounted
  // pricing (clientDiscountPercent).
  referrerType          String               @default("COMMISSION") // COMMISSION | DISCOUNT
  clientDiscountPercent Decimal? // % discount for this referrer's clients (DISCOUNT type)
  // Commission tier configuration (COMMISSION type only)
  commissionType        String               @default("FIXED") // FIXED | VOLUME_BASED
  fixedCommissionAmount Decimal? // Used when commissionType = FIXED
  // Referrer hierarchy — who referred this referrer
  parentReferrerId      String?
  cases                 Case[]
  createdBy             User?                @relation("ReferrerCreator", fields: [createdById], references: [id])
  portalUser            User?                @relation("ReferrerPortalUser", fields: [portalUserId], references: [id], onDelete: SetNull)
  project               Project?             @relation(fields: [projectId], references: [id])
  commissions           ReferrerCommission[]
  paymentQueries        ReferrerPaymentQuery[]
  parentReferrer        Referrer?            @relation("ReferrerHierarchy", fields: [parentReferrerId], references: [id])
  referredReferrers     Referrer[]           @relation("ReferrerHierarchy")

  @@index([lastName])
  @@index([idNumber])
  @@index([isActive])
  @@index([parentReferrerId])
  @@index([portalUserId])
}

model ReferrerCommission {
  id               String                  @id @default(cuid())
  referrerId       String
  caseId           String                  @unique
  stage            ReferrerCommissionStage @default(NEW_LEAD)
  isEligible       Boolean                 @default(false)
  commissionAmount Decimal?
  isPaid           Boolean                 @default(false)
  paidAt           DateTime?
  paidById         String?
  paymentRef       String?
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  case             Case                    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  paidBy           User?                   @relation("CommissionPaidBy", fields: [paidById], references: [id])
  referrer         Referrer                @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  paymentQueries   ReferrerPaymentQuery[]

  @@index([referrerId])
  @@index([isPaid])
  @@index([isEligible])
  @@index([stage])
}

model ReferrerPaymentQuery {
  id                String               @id @default(cuid())
  referrerId        String
  caseId            String
  commissionId      String?
  submittedByUserId String
  status            String               @default("PENDING") // PENDING | IN_REVIEW | RESOLVED | REJECTED
  claimedPaidAt     DateTime?
  claimedAmount     Decimal?
  notes             String?
  adminNotes        String?
  resolvedAt        DateTime?
  resolvedById      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  case              Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  commission        ReferrerCommission?  @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  referrer          Referrer             @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  resolvedBy        User?                @relation("ReferrerPaymentQueryResolver", fields: [resolvedById], references: [id])
  submittedBy       User                 @relation("ReferrerPaymentQuerySubmitter", fields: [submittedByUserId], references: [id])

  @@index([referrerId])
  @@index([caseId])
  @@index([commissionId])
  @@index([status])
  @@index([createdAt])
}

model Client {
  id                  String                     @id @default(cuid())
  firstName           String
  lastName            String
  idNumber            String                     @unique
  email               String?
  phone               String?
  whatsappNumber      String?
  telegramNumber      String?
  address             String?
  employer            String?
  employeeNo          String?
  grossSalary         Decimal?
  netSalary           Decimal?
  salaryPayDate       Int?
  type                String                     @default("Standard")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  ghlContactId        String?
  alternativeEmail    String?
  alternativePhone    String?
  alternativePhone2   String?
  // Banking details for debit order collection
  bankName            String?
  accountHolderName   String?
  accountNumber       String?
  accountType         String?
  branchCode          String?
  debitOrderDay       Int?
  cases               Case[]                     @relation("PrimaryClient")
  jointCases          Case[]                     @relation("JointClient")
  consumerAccount     ConsumerAccount?
  creditAccounts      CreditAccount[]
  invoices            Invoice[]
  LegalMatter         LegalMatter[]
  payments            Payment[]
  automationRuns      AutomationRun[]
  poaSigningRequests  PoaSigningRequest[]
  drrConsents         DebtReviewRemovalConsent[]
  debitOrderMandates  DebitOrderMandate[]
  paymentArrangements PaymentArrangement[]
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([action])
}

model NotificationQueue {
  id          String    @id @default(cuid())
  caseId      String
  channel     String // SMS, EMAIL, WHATSAPP
  recipient   String
  subject     String?
  body        String
  htmlBody    String?
  optionsJson String? // For CCs and attachments
  status      String    @default("PENDING_RETRY") // PENDING_RETRY, SUCCESS, FAILED_FINAL, HUMAN_REVIEW, CANCELLED
  retryCount  Int       @default(0)
  nextRetryAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([status])
  @@index([nextRetryAt])
}

model Case {
  id                      String                     @id @default(cuid())
  fileNumber              String                     @unique
  clientId                String
  jointClientId           String?
  acquisitionType         String                     @default("B2C")
  partnerName             String?
  partnerBranch           String?
  r350Status              String                     @default("NOT_APPLICABLE") // NOT_APPLICABLE | PENDING | PAID_R350 | FILE_PAID | TOLD_R350 | WAITING_R350 | WAIVED
  r350PaidDate            DateTime?
  r350PaidRef             String?
  r350PaidById            String?
  r350Waived              Boolean                    @default(false)
  r350WaivedById          String?
  r350WaivedAt            DateTime?
  r350WaivedReason        String?
  r350InvoiceId           String?
  r350InvoiceSentAt       DateTime?
  serviceFeeCollectedBy   String                     @default("ZENOWETHU")
  partnerSplitPercent     Int                        @default(0)
  status                  String
  statusEntryDate         DateTime                   @default(now())
  deadline                DateTime?
  isOverdue               Boolean                    @default(false)
  daysInStatus            Int                        @default(0)
  serviceFee              Decimal?
  instalments             Int                        @default(1)
  zenowethuShare          Decimal?
  isInvoiced              Boolean                    @default(false)
  closedAccounts          Int                        @default(0)
  openAccounts            Int                        @default(0)
  prescribedAccounts      Int                        @default(0)
  totalDebtAmount         Decimal?                   @default(0)
  totalMonthlyInstallment Decimal?                   @default(0)
  cb_ncrdcNo              String?
  cb_debtCounsellor       String?
  cb_contactNo            String?
  cb_applicationDate      DateTime?
  cb_status               String?
  cb_statusDate           DateTime?
  ncrdcNo                 String?
  dhsStatus               String?
  // Manual staff override: DHS sometimes drops a file into our DC profile without a
  // formal "Accepted"/"Auto Transferred" status. Staff tick this to mark the file as
  // Accepted via DHS so the Manage Consumers (consent) follow-on can proceed.
  manuallyAcceptedViaDhs  Boolean                    @default(false)
  dhsDaysCounter          String?
  debtReviewDate          DateTime?
  debtCounsellorName      String?
  dcTradingName           String?
  dcEmail                 String?
  lastKnownEmail          String?
  preferredDcEmail        String?
  dcOperatingStatus       String?
  dcMobile                String?
  consumerDhsStatus       String?
  requestedDhsStatus      String?
  dhsPreviousStatus       String?
  previousDebtCounsellor  String?
  dhsStatusDate           DateTime?
  dhsApplicationDate      DateTime?
  afterCareFees           Decimal?
  legalFees               Decimal?
  legalFeesStatus         String?
  legalFeesPayment        String?
  legalFeesInvDate        DateTime?
  feesConsent             Decimal?
  totalFees               Decimal?
  affordabilityStatus     String?
  assessmentDate          DateTime?
  nextUpdate              DateTime?
  fileToBeCompleted       DateTime?
  insuranceNotes          String?
  category                String                     @default("Standard")
  services                String?
  todos                   String?
  declineReason           String?
  declineReasonAttended   Boolean                    @default(false)
  declineFirstDetectedAt  DateTime? // When decline was FIRST detected (never updated, used for window calculation)
  declineLastDetectedAt   DateTime? // Most recent decline detection (updated on each new decline, visible in UI)
  description             String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  assignedToId            String?
  createdById             String?
  aiAutonomyLevel         String                     @default("CO_PILOT")
  nctCaseNumber           String?
  nctEPurseBalance        Decimal?
  nctFilingDate           DateTime?
  nctLastUpdated          DateTime?
  nctStatus               String?
  planReadyToStart        Boolean                    @default(false)
  ncrSysRef               String?
  dcProvince              String?
  dcTel                   String?
  lastUsedMobile          String?
  lastUsedTel             String?
  referrerId              String?
  isAdminOnly             Boolean                    @default(false)
  ghlOpportunityId        String?
  leadSource              String?
  marketingData           Json?
  updatedById             String?
  deletedAt               DateTime?
  deletedById             String?
  assignedTo              User?                      @relation("CaseAssignee", fields: [assignedToId], references: [id])
  client                  Client                     @relation("PrimaryClient", fields: [clientId], references: [id])
  jointClient             Client?                    @relation("JointClient", fields: [jointClientId], references: [id])
  createdBy               User?                      @relation("CaseCreator", fields: [createdById], references: [id])
  deletedBy               User?                      @relation("CaseDeleter", fields: [deletedById], references: [id])
  referrer                Referrer?                  @relation(fields: [referrerId], references: [id])
  updatedBy               User?                      @relation("CaseUpdater", fields: [updatedById], references: [id])
  r350PaidBy              User?                      @relation("CaseR350PaidBy", fields: [r350PaidById], references: [id])
  r350WaivedBy            User?                      @relation("CaseR350WaivedBy", fields: [r350WaivedById], references: [id])
  assignments             CaseAssignment[]
  comments                CaseComment[]
  followers               CaseFollower[]
  plan                    CasePlan?
  projects                CaseProject[]
  creditAccounts          CreditAccount[]
  debtReviewDocuments     DebtReviewDocument[]
  documents               Document[]
  ForensicAudit           ForensicAudit[]
  InsuranceAssessment     InsuranceAssessment[]
  invoices                Invoice[]
  LegalMatter             LegalMatter[]
  notifications           NotificationLog[]
  payments                Payment[]
  referrerCommission      ReferrerCommission?
  referrerPaymentQueries  ReferrerPaymentQuery[]
  workflowLogs            WorkflowLog[]
  automationRuns          AutomationRun[]
  notificationQueue       NotificationQueue[]
  poaSigningRequests      PoaSigningRequest[]
  debitOrderMandates      DebitOrderMandate[]
  appNextUpdates          CaseAppNextUpdate[]
  paymentArrangements     PaymentArrangement[]
  documentRequests        DocumentRequest[]
  drrConsents             DebtReviewRemovalConsent[]

  debtCounsellordId String?
  debtCounsellor    DebtCounsellor? @relation(fields: [debtCounsellordId], references: [id])

  @@index([status])
  @@index([isOverdue])
  @@index([updatedAt])
  @@index([createdAt])
  @@index([referrerId])
  @@index([isAdminOnly])
  @@index([deletedAt])
  @@index([debtCounsellordId])
}

model DebtCounsellor {
  id              String                       @id @default(cuid())
  ncrdcNo         String                       @unique
  fullName        String?
  tradingName     String?
  operatingStatus String?
  province        String?
  tel             String?
  mobile          String?
  fax             String?
  email           String?
  preferredEmail  String?
  lastKnownEmail  String?
  notes           String?
  staffNotes      String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  updatedById     String?
  updatedBy       User?                        @relation("DCUpdatedBy", fields: [updatedById], references: [id])
  cases           Case[]
  emailHistory    DebtCounsellorEmailHistory[]
}

model DebtCounsellorEmailHistory {
  id                String         @id @default(cuid())
  debtCounsellordId String
  email             String
  source            String
  recordedAt        DateTime       @default(now())
  notes             String?
  debtCounsellor    DebtCounsellor @relation(fields: [debtCounsellordId], references: [id], onDelete: Cascade)

  @@index([debtCounsellordId])
}

model Document {
  id            String                @id @default(cuid())
  caseId        String
  type          String
  fileName      String
  fileUrl       String
  fileSize      Int
  mimeType      String
  uploadedAt    DateTime              @default(now())
  analyzedAt    DateTime?
  extractedData String?
  uploadedById  String?
  isAdminOnly   Boolean               @default(false)
  case          Case                  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy    User?                 @relation(fields: [uploadedById], references: [id])
  accessGrants  DocumentAccessGrant[]

  @@index([caseId])
  @@index([type])
  @@index([uploadedById])
  @@index([isAdminOnly])
}

model DocumentAccessGrant {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  grantedAt  DateTime @default(now())
  grantedBy  String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  granter    User     @relation("DocumentAccessGranter", fields: [grantedBy], references: [id])
  user       User     @relation("DocumentAccessGrantee", fields: [userId], references: [id])

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

model CaseProject {
  caseId    String
  projectId String
  isPrimary Boolean @default(false)
  case      Case    @relation(fields: [caseId], references: [id])
  project   Project @relation(fields: [projectId], references: [id])

  @@id([caseId, projectId])
  @@index([projectId])
}

model WorkflowLog {
  id         String   @id @default(cuid())
  caseId     String
  fromStatus String?
  toStatus   String
  action     String   @default("STATUS_CHANGE")
  timestamp  DateTime @default(now())
  userId     String?
  notes      String?
  case       Case     @relation(fields: [caseId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
}

model User {
  id                         String                         @id @default(cuid())
  username                   String                         @unique
  firstName                  String
  lastName                   String
  email                      String                         @unique
  password                   String
  organization               String                         @default("Zenowethu")
  isAdmin                    Boolean                        @default(false)
  isLocked                   Boolean                        @default(false)
  emailNotificationsEnabled  Boolean                        @default(true)
  createdAt                  DateTime                       @default(now())
  lastLogin                  DateTime?
  b2bPartnerId               String?
  phone                      String?
  role                       String                         @default("MEMBER")
  userType                   String                         @default("STAFF")
  avatarUrl                  String?
  resetPasswordExpires       DateTime?
  resetPasswordToken         String?                        @unique
  idNumber                   String?
  address                    String?
  AuditEvidence              AuditEvidence[]
  casesAssigned              Case[]                         @relation("CaseAssignee")
  casesCreated               Case[]                         @relation("CaseCreator")
  casesDeleted               Case[]                         @relation("CaseDeleter")
  casesUpdated               Case[]                         @relation("CaseUpdater")
  caseAssignments            CaseAssignment[]
  comments                   CaseComment[]
  caseFollows                CaseFollower[]
  approvedPlans              CasePlan[]                     @relation("PlanApprover")
  mentions                   CommentMention[]
  dccpCredential             DCCPCredential?
  staffBankingDetail         StaffBankingDetail?
  approvedDebtReviewDocs     DebtReviewDocument[]           @relation("DebtReviewDocumentApprover")
  uploadedServiceConsents    CreditProviderServiceConsentDocument[] @relation("CreditProviderServiceConsentUploader")
  uploadedDocuments          Document[]
  grantedDocumentAccess      DocumentAccessGrant[]          @relation("DocumentAccessGranter")
  documentAccessGrants       DocumentAccessGrant[]          @relation("DocumentAccessGrantee")
  ForensicAudit              ForensicAudit[]
  inAppNotifications         InAppNotification[]
  invoicesCreated            Invoice[]                      @relation("InvoiceCreator")
  invoicesDecided            Invoice[]                      @relation("InvoiceDecider")
  invoicesPersonalBanking    Invoice[]                      @relation("InvoicePersonalBanking")
  sentNotifications          NotificationLog[]              @relation("SentNotifications")
  recordedPayments           Payment[]                      @relation("PaymentRecorder")
  uploadedBatches            PaymentBatch[]
  projectMemberships         ProjectMember[]
  createdReferrers           Referrer[]                     @relation("ReferrerCreator")
  referrerPortalProfile      Referrer?                      @relation("ReferrerPortalUser")
  commissionsPaid            ReferrerCommission[]           @relation("CommissionPaidBy")
  referrerPaymentQueries     ReferrerPaymentQuery[]         @relation("ReferrerPaymentQuerySubmitter")
  resolvedReferrerQueries    ReferrerPaymentQuery[]         @relation("ReferrerPaymentQueryResolver")
  r350PaymentsRecorded       Case[]                         @relation("CaseR350PaidBy")
  r350WaiversRecorded        Case[]                         @relation("CaseR350WaivedBy")
  b2bPartner                 Project?                       @relation("B2BPartnerUsers", fields: [b2bPartnerId], references: [id])
  groupMemberships           UserGroupMember[]
  workflowLogs               WorkflowLog[]
  assignedLeads              Lead[]                         @relation("LeadAssignment")
  automationRuns             AutomationRun[]
  triggeredAutomations       AutomationRun[]                @relation("AutomationTrigger")
  debtCounsellorsUpdated     DebtCounsellor[]               @relation("DCUpdatedBy")
  debitOrderMandates         DebitOrderMandate[]            @relation("MandateRecorder")
  caseAppNextUpdates         CaseAppNextUpdate[]            @relation("CaseAppNextUpdateUpdater")
  paymentArrangementsCreated PaymentArrangement[]           @relation("ArrangementCreator")
  instalmentsHonoured        PaymentArrangementInstalment[] @relation("InstalmentHonouredBy")
  personalMailbox            MailboxAccount?                @relation("MailboxOwner")
}

// Debit order mandate lifecycle — capture, send, sign-back, NuPay registration
model DebitOrderMandate {
  id                  String               @id @default(cuid())
  caseId              String?
  clientId            String
  // Whether the consumer has requested / consented to a debit order mandate
  requested           Boolean              @default(false)
  // Snapshot of banking details at the time the mandate was raised
  bankName            String?
  accountHolderName   String?
  accountNumber       String?
  accountType         String?
  branchCode          String?
  // Mandate terms
  amount              Decimal?
  frequency           String               @default("MONTHLY") // MONTHLY | WEEKLY
  numInstalments      Int?
  debitOrderDay       Int?
  firstCollectionDate DateTime?
  lastCollectionDate  DateTime?
  // Lifecycle status
  status              String               @default("DRAFT") // DRAFT | SENT | SIGNED | REGISTERED | ACTIVE | CANCELLED | REJECTED
  // Send / sign-back tracking
  sentAt              DateTime?
  sentTo              String?
  signedReturnedAt    DateTime?
  // Document linkage (uploaded to the case document vault)
  signedDocumentId    String?
  nupayDocumentId     String?
  nupayReference      String?
  nupayRegisteredAt   DateTime?
  notes               String?
  recordedById        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  case                Case?                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client              Client               @relation(fields: [clientId], references: [id])
  recordedBy          User?                @relation("MandateRecorder", fields: [recordedById], references: [id])
  paymentArrangements PaymentArrangement[]

  @@index([caseId])
  @@index([clientId])
  @@index([status])
}

// Per-app "next update / next action" date for a case.
// Each app (CASES, FINANCE, LEGAL, INSURANCE, CREDO, FORENSIC) owns its OWN
// row so a date set in one app NEVER appears in another. This lets each
// discipline track when its part of a file is due independently — a file is
// not "not yet due" just because the Cases side isn't due yet.
model CaseAppNextUpdate {
  id             String    @id @default(cuid())
  caseId         String
  app            String // CASES | FINANCE | LEGAL | INSURANCE | CREDO | FORENSIC
  nextUpdateDate DateTime?
  isOverdue      Boolean   @default(false)
  note           String?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  case           Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  updatedBy      User?     @relation("CaseAppNextUpdateUpdater", fields: [updatedById], references: [id])

  @@unique([caseId, app])
  @@index([caseId])
  @@index([app, nextUpdateDate])
  @@index([app, isOverdue])
}

// A payment arrangement (promise-to-pay) for a consumer. Available to all
// clients (B2C primary, also B2B legal-fee files). Can be a single instalment
// or a multi-instalment schedule. When source = MANDATE it is generated from
// an approved DebitOrderMandate.
model PaymentArrangement {
  id          String                         @id @default(cuid())
  caseId      String?
  clientId    String
  source      String                         @default("MANUAL") // MANUAL | MANDATE
  mandateId   String?
  status      String                         @default("ACTIVE") // ACTIVE | COMPLETED | DEFAULTED | CANCELLED
  totalAmount Decimal                        @default(0)
  frequency   String                         @default("MONTHLY") // MONTHLY | WEEKLY | ONCE
  reason      String? // e.g. service fees, legal fees
  notes       String?
  createdById String?
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  case        Case?                          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client      Client                         @relation(fields: [clientId], references: [id])
  mandate     DebitOrderMandate?             @relation(fields: [mandateId], references: [id])
  createdBy   User?                          @relation("ArrangementCreator", fields: [createdById], references: [id])
  instalments PaymentArrangementInstalment[]

  @@index([caseId])
  @@index([clientId])
  @@index([status])
  @@index([mandateId])
}

// A single dated instalment line within a payment arrangement. Its dueDate
// drives the Finance "Next Payment Date" and the per-app overdue trigger.
model PaymentArrangementInstalment {
  id            String             @id @default(cuid())
  arrangementId String
  sequence      Int
  dueDate       DateTime
  amountDue     Decimal
  amountPaid    Decimal            @default(0)
  status        String             @default("PENDING") // PENDING | PAID | PARTIAL | MISSED | WAIVED
  paidAt        DateTime?
  honouredById  String? // staff who manually confirmed honoured / missed
  honouredAt    DateTime?
  note          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  arrangement   PaymentArrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
  honouredBy    User?              @relation("InstalmentHonouredBy", fields: [honouredById], references: [id])

  @@index([arrangementId])
  @@index([dueDate])
  @@index([status])
}

model CaseAssignment {
  caseId     String
  userId     String
  assignedAt DateTime @default(now())
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
