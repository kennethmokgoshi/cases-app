  @@index([category])
}

model Payment {
  id           String        @id @default(cuid())
  amount       Decimal
  date         DateTime
  method       String
  reference    String?
  category     String        @default("INSTALLMENT")
  status       String        @default("COMPLETED")
  notes        String?
  proofOfPaymentUrl String?
  clientId     String?
  caseId       String?
  batchId      String?
  unmatchedId  String?
  invoiceId    String?
  recordedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  batch        PaymentBatch? @relation(fields: [batchId], references: [id])
  case         Case?         @relation(fields: [caseId], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id])
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  recordedBy   User?         @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([clientId])
  @@index([caseId])
  @@index([batchId])
  @@index([invoiceId])
  @@index([date])
  @@index([status])
}

model PaymentBatch {
  id           String    @id @default(cuid())
